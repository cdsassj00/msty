---
import Base from './Base.astro';
import { LABELS, formatDate, groupOf, colorOf, postUrl, type CollectionName } from '../lib/posts';

interface Props {
  entry: any;
  headings?: { depth: number; slug: string; text: string }[];
  prev?: any;
  next?: any;
  siblings?: any[];
}
const { entry, headings = [], prev, next, siblings = [] } = Astro.props;
const label = LABELS[entry.collection as CollectionName];
const { title, description, date, updated, tags, verified } = entry.data;
const group = groupOf(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasSide = siblings.length > 1;
---
<Base title={title} description={description}>
  <article class={`c-${colorOf(entry)}`}>
    <header class="article-head">
      <div class="wrap wide">
        <p class="crumbs">
          <a href="/">홈</a><span class="sep">›</span>
          <a href={`/${entry.collection}/`}>{label.title}</a>
          {group && <><span class="sep">›</span><span class="here">{group}</span></>}
        </p>
        <h1 class="h-judge">{title}</h1>
        <p class="meta">
          {formatDate(date)}
          {updated && ` · 수정 ${formatDate(updated)}`}
          {verified && ` · 공식 문서 확인 ${formatDate(verified)}`}
        </p>
        {tags.length > 0 && <div class="chip-row" style="margin-top:12px">{tags.map((t: string) => <span class="chip chip-plain">{t}</span>)}</div>}
      </div>
    </header>
    <div class="article-body">
      <div class={`wrap wide article-layout ${hasSide ? 'has-side' : ''}`}>
        {hasSide && (
          <details class="side" open>
            <summary>{group} · 글 {siblings.length}편</summary>
            <span class="side-title">{group}</span>
            <ol>
              {siblings.map((s) => (
                <li><a href={postUrl(s.collection, s.id)} aria-current={s.id === entry.id ? 'page' : undefined}>{s.data.title}</a></li>
              ))}
            </ol>
          </details>
        )}
        <div>
          <p class="summary"><b>이 글에서 다루는 것</b>{description}</p>
          <div class="prose"><slot /></div>
          {(prev || next) && (
            <nav class="pager" aria-label="이전 글과 다음 글">
              {prev ? <a href={postUrl(prev.collection, prev.id)}><span>← 이전 글</span><b>{prev.data.title}</b></a> : <span></span>}
              {next && <a class="next" href={postUrl(next.collection, next.id)}><span>다음 글 →</span><b>{next.data.title}</b></a>}
            </nav>
          )}
        </div>
        {toc.length > 2 && (
          <nav class="toc" aria-label="이 글의 목차">
            <b>목차</b>
            <ol>{toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
      </div>
    </div>
  </article>
</Base>

<script is:inline>
  // 좁은 화면에서는 같은 묶음의 글 목록을 접어 둔다.
  if (matchMedia('(max-width: 1279px)').matches) document.querySelector('details.side')?.removeAttribute('open');
</script>

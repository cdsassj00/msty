---
import '../styles/tokens.css';
import '../styles/site.css';
import '../styles/theme.css';
import '../styles/sections.css';
import '../styles/polish.css';
import '../styles/editorial.css';
import { SITE } from '../data/site';

interface Props { title: string; description?: string }
const { title, description = SITE.description } = Astro.props;
const pageTitle = title === SITE.name ? `${SITE.name} — ${SITE.tagline}` : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const beacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" /></noscript>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script is:inline>try { if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark'; } catch {}</script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">{SITE.name}</a>
        <nav class="site-nav scroll-thin" aria-label="주 메뉴">
          {SITE.nav.map((n) => <a href={n.href} aria-current={Astro.url.pathname.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <a class="btn-link" href="/download/">다운로드</a>
        <button id="theme-toggle" type="button">테마 전환</button>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-top">
          <p>Msty Korea · 로컬 우선 AI 한국어 가이드</p>
          <nav aria-label="바닥 메뉴">
            <a href="/guide/">가이드</a><a href="/learn/">학습</a><a href="/models/">모델 찾기</a><a href="/lab/">실습</a><a href="/glossary/">용어</a><a href="/about/">소개</a><a href="/rss.xml">RSS</a>
          </nav>
        </div>
        <span class="wordmark" aria-hidden="true">msty korea*</span>
        <div class="foot-bottom">
          <p>운영 <a href={SITE.links.cdsa} target="_blank" rel="noopener">{SITE.operator}</a></p>
          <p>문의 <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        </div>
      </div>
    </footer>
    <script is:inline>
      // 화면에 들어온 요소를 나타나게 한다. 위치를 직접 재므로 주소의 #이동이나 숨은 탭에서도 빠뜨리지 않는다.
      (() => {
        let pending = [...document.querySelectorAll('[data-reveal],[data-stagger]')];
        let queued = false;
        const check = () => {
          queued = false;
          pending = pending.filter((el) => {
            if (el.getBoundingClientRect().top > innerHeight * 0.92) return true;
            el.classList.add('show');
            return false;
          });
        };
        const schedule = () => { if (!queued) { queued = true; requestAnimationFrame(check); } };
        check();
        for (const type of ['scroll', 'resize', 'hashchange', 'load']) addEventListener(type, schedule, { passive: true });
        // 탭이 가려져 그리기가 멈춘 경우에 대비해 주기적으로도 확인한다.
        const timer = setInterval(() => { check(); if (pending.length === 0) clearInterval(timer); }, 600);
      })();
      // 작은 라벨이 화면에 들어올 때 글자가 섞였다가 맞춰지는 효과. 모션 줄이기 설정이면 건너뛴다.
      (() => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const glyphs = '01<>/=+*#%&';
        let labels = [...document.querySelectorAll('.eyebrow')];
        const run = (el) => {
          const text = el.textContent;
          el.setAttribute('aria-label', text);
          let frame = 0;
          const total = 18;
          const tick = () => {
            frame++;
            const fixed = Math.floor((frame / total) * text.length);
            el.textContent = [...text].map((ch, i) => (i < fixed || ch === ' ' ? ch : glyphs[Math.floor(Math.random() * glyphs.length)])).join('');
            if (frame < total) setTimeout(tick, 40); else el.textContent = text;
          };
          tick();
        };
        const check = () => {
          labels = labels.filter((el) => {
            if (el.getBoundingClientRect().top > innerHeight * 0.9) return true;
            run(el);
            return false;
          });
        };
        check();
        addEventListener('scroll', check, { passive: true });
      })();
      // 검은 패널의 알약을 끌어서 던질 수 있게 한다. 짧게 누르면 그대로 링크로 이동한다.
      (() => {
        const box = document.querySelector('.toolkit');
        if (!box || matchMedia('(prefers-reduced-motion: reduce)').matches || !matchMedia('(pointer: fine)').matches) return;
        for (const pill of box.querySelectorAll('a')) {
          let x = 0, y = 0, vx = 0, vy = 0, sx = 0, sy = 0, lx = 0, ly = 0, moved = false, dragging = false, raf = 0;
          const paint = () => { pill.style.transform = `translate(${x}px, ${y}px)`; };
          const coast = () => {
            vx *= 0.94; vy *= 0.94; x += vx; y += vy;
            const b = box.getBoundingClientRect(), r = pill.getBoundingClientRect();
            if (r.left < b.left || r.right > b.right) { vx = -vx * 0.7; x += vx * 2; }
            if (r.top < b.top || r.bottom > b.bottom) { vy = -vy * 0.7; y += vy * 2; }
            paint();
            if (Math.abs(vx) + Math.abs(vy) > 0.3) raf = requestAnimationFrame(coast);
          };
          pill.addEventListener('pointerdown', (e) => {
            dragging = true; moved = false; sx = e.clientX - x; sy = e.clientY - y; lx = e.clientX; ly = e.clientY;
            cancelAnimationFrame(raf); pill.setPointerCapture(e.pointerId); pill.style.transition = 'none';
          });
          pill.addEventListener('pointermove', (e) => {
            if (!dragging) return;
            if (Math.abs(e.clientX - sx - x) + Math.abs(e.clientY - sy - y) > 4) moved = true;
            vx = e.clientX - lx; vy = e.clientY - ly; lx = e.clientX; ly = e.clientY;
            x = e.clientX - sx; y = e.clientY - sy; paint();
          });
          pill.addEventListener('pointerup', () => { dragging = false; if (moved) raf = requestAnimationFrame(coast); });
          pill.addEventListener('click', (e) => { if (moved) e.preventDefault(); });
          pill.addEventListener('dragstart', (e) => e.preventDefault());
        }
      })();
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme !== 'dark';
        if (dark) root.dataset.theme = 'dark'; else delete root.dataset.theme;
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
      });
    </script>
    {beacon && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beacon })}></script>}
  </body>
</html>

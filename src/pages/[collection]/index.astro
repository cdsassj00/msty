---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { COLLECTIONS, LABELS, getPosts, type CollectionName } from '../../lib/posts';
import { SERIES } from '../../data/series';

export function getStaticPaths() {
  return COLLECTIONS.map((collection) => ({ params: { collection } }));
}
const collection = Astro.params.collection as CollectionName;
const posts = await getPosts(collection);
const label = LABELS[collection];
// 학습 글은 시리즈로 묶고 시리즈 안에서는 order 순으로 보여 준다.
const groups = collection === 'learn'
  ? SERIES.map((name) => ({
      name,
      posts: posts.filter((p: any) => p.data.series === name).sort((a: any, b: any) => a.data.order - b.data.order),
    })).filter((g) => g.posts.length > 0)
  : [];
---
<Base title={label.title} description={label.lead}>
  <section class="section">
    <div class="wrap">
      <h1 class="h-judge">{label.title}</h1>
      <p class="lead">{label.lead}</p>
      {posts.length === 0 && <p class="meta" style="margin-top:32px">아직 올라온 글이 없습니다.</p>}
      {groups.length > 0 && (
        <div class="chip-row" style="margin-top:24px">
          {groups.map((g, i) => <a class="chip chip-plain" href={`#s${i + 1}`}>{g.name} {g.posts.length}</a>)}
        </div>
      )}
      {groups.map((g, i) => (
        <>
          <h2 class="h-judge series-title" id={`s${i + 1}`}>{g.name}</h2>
          <div class="grid">{g.posts.map((entry) => <PostCard entry={entry} />)}</div>
        </>
      ))}
      {groups.length === 0 && posts.length > 0 && (
        <div class="grid" style="margin-top:32px">{posts.map((entry) => <PostCard entry={entry} />)}</div>
      )}
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { SERIES } from '../data/series';
import { getAllPosts, getPosts } from '../lib/posts';
import demos from '../data/lab.json';
import terms from '../data/glossary.json';
import links from '../data/model-links.json';

const [all, guides, learn] = await Promise.all([getAllPosts(), getPosts('guide'), getPosts('learn')]);
const latest = all.slice(0, 6);

// 제품별 가이드 편수. 제품 카드에 함께 보여 준다.
const bySection = (name: string) => guides.filter((g: any) => g.data.section === name).length;
const guideCount: Record<string, number> = { Studio: guides.length - bySection('Msty Go') - bySection('Msty Nexus') - bySection('Msty 제품과 요금'), Go: bySection('Msty Go') + 1, Nexus: bySection('Msty Nexus') + 1 };

const stats = [
  { n: guides.length, label: 'Msty 가이드', href: '/guide/', c: 'blue' },
  { n: learn.length, label: '로컬 AI 학습 글', href: '/learn/', c: 'purple' },
  { n: demos.length, label: '브라우저 실습', href: '/lab/', c: 'green' },
  { n: terms.length, label: '용어 풀이', href: '/glossary/', c: 'orange' },
  { n: links.length, label: '모델 사이트', href: '/models/', c: 'teal' },
];

const reasons = [
  { icon: 'lock', c: 'blue', title: '자료가 밖으로 나가지 않습니다', body: '질문과 문서를 내 PC 안의 모델이 처리합니다. 사내 문서, 개인정보가 섞인 자료, 외부 반출이 막힌 업무에 쓸 수 있습니다.' },
  { icon: 'coin', c: 'green', title: '건수가 늘어도 요금이 붙지 않습니다', body: '모델을 한 번 받으면 몇 번을 물어도 추가 비용이 없습니다. 같은 작업을 수백 건 반복하는 분류, 요약, 정리에 맞습니다.' },
  { icon: 'swap', c: 'purple', title: '필요할 때만 온라인 모델을 씁니다', body: '어려운 추론이나 긴 글은 온라인 모델에, 민감한 자료는 로컬 모델에 맡깁니다. Msty는 둘을 한 화면에서 골라 쓰게 해 줍니다.' },
];

const products = [
  {
    name: 'Studio', icon: 'chat', c: 'blue', role: '개인과 팀의 AI 작업 공간', status: '무료로 시작', href: '/guide/product-studio/',
    points: ['로컬 모델과 온라인 모델을 한 화면에서 대화', '내 문서를 근거로 답하는 Knowledge Stacks', '여러 모델을 나란히 비교하는 Split Chats', '도구를 쓰는 여러 단계 작업, Agent Mode', '프롬프트·페르소나·스킬을 만들어 재사용'],
  },
  {
    name: 'Go', icon: 'target', c: 'green', role: '범위를 정해 맡기는 에이전트', status: '무료 베타', href: '/guide/product-go/',
    points: ['할 일과 한계를 정해 에이전트에게 맡김', '단계마다 결과를 확인하고 승인', '데스크톱과 모바일에서 진행 상황 확인', '로컬 모델과 온라인 모델 모두 사용'],
  },
  {
    name: 'Nexus', icon: 'gate', c: 'purple', role: '모델 연결을 관리하는 제어 센터', status: '사용 가능', href: '/guide/product-nexus/',
    points: ['실행 엔진과 온라인 제공업체를 한곳에서 관리', 'API 키와 앱 토큰 관리', '정책과 사용량 확인', '여러 AI 앱이 같은 관문을 거치게 구성'],
  },
  {
    name: 'Stack', icon: 'layers', c: 'orange', role: '승인된 자료를 묶는 지식 계층', status: '출시 예정', href: '/guide/product-stack/',
    points: ['검증된 자료를 버전이 있는 묶음으로 관리', '승인된 AI 앱만 꺼내 쓰도록 통제', '팀과 조직 단위의 자료 관리'],
  },
];

const features = [
  { icon: 'cube', c: 'blue', wide: true, pat: '', name: '모델 선택', href: '/guide/models-model-hub/', body: '로컬 엔진(MLX, llama.cpp, Ollama)과 온라인 제공업체를 한곳에 연결하고 대화마다 골라 씁니다.' },
  { icon: 'book', c: 'green', wide: true, pat: 'stripe', name: 'Knowledge Stacks', href: '/guide/ks-overview/', body: '내 문서와 노트를 넣어 두면 그 내용을 근거로 답하고 출처를 함께 보여 줍니다.' },
  { icon: 'columns', c: 'purple', pat: 'ring', name: 'Split Chat', href: '/guide/chat-split-chat/', body: '같은 질문을 여러 모델에 동시에 보내 답을 나란히 비교합니다.' },
  { icon: 'bolt', c: 'orange', pat: '', name: 'Agent Mode', href: '/guide/agent-mode/', body: 'Codex, Claude Code, Gemini CLI 같은 코딩 에이전트를 연결해 여러 단계 작업을 맡깁니다.' },
  { icon: 'users', c: 'teal', pat: 'stripe', name: 'Crew 대화', href: '/guide/chat-crew-conversations/', body: '역할이 다른 페르소나 여러 명을 한 대화에 불러 함께 검토하게 합니다.' },
  { icon: 'wand', c: 'pink', pat: 'ring', name: 'Prompt·Persona·Skills', href: '/guide/studio-prompt/', body: '자주 쓰는 프롬프트, 역할, 작업 방식을 만들어 두고 다시 꺼내 씁니다.' },
  { icon: 'image', c: 'purple', pat: '', name: 'Media Studio', href: '/guide/studio-media/', body: '이미지와 영상을 만듭니다.' },
  { icon: 'shield', c: 'blue', pat: 'stripe', name: '팀 통제', href: '/guide/security-governance/', body: 'SSO, 역할별 권한, 모델과 기능 제한, 관리자 감사 로그를 제공합니다.' },
];

const steps = [
  { n: 1, title: '설치합니다', body: 'Msty 공식 사이트에서 내 운영체제에 맞는 Studio를 받아 설치합니다.', href: '/download/', cta: '다운로드 안내' },
  { n: 2, title: '첫 모델을 받습니다', body: 'Msty가 내 PC 사양을 확인해 모델을 추천합니다. 가벼운 쪽과 강력한 쪽 사이에서 고릅니다.', href: '/guide/first-run-and-models/', cta: '첫 실행과 모델 받기' },
  { n: 3, title: '대화를 시작합니다', body: '일반 대화를 열어 질문합니다. 익숙해지면 내 문서를 넣고, 온라인 모델도 함께 연결합니다.', href: '/guide/', cta: '가이드 전체 보기' },
];

const seriesInfo: Record<string, { body: string; icon: string; c: string }> = {
  '로컬 AI 기초': { icon: 'cube', c: 'blue', body: '로컬 AI가 무엇인지, 모델 이름과 크기를 읽는 법, 내 PC로 무엇을 돌릴 수 있는지 다룹니다.' },
  'Ollama 실전': { icon: 'terminal', c: 'green', body: '모델 관리, Modelfile, API 호출, 엑셀·웹 연결, 문제 해결, 사무실에서 함께 쓰기까지 다룹니다.' },
  'RAG와 임베딩': { icon: 'search', c: 'purple', body: '내 문서를 근거로 답하게 만드는 원리와 방법을 처음부터 설명합니다.' },
  '폐쇄망·공공기관 활용': { icon: 'building', c: 'teal', body: '외부망이 막힌 환경에서 할 수 있는 AI 업무와 설치 전에 확인할 것을 정리합니다.' },
  '만들어 보기': { icon: 'hammer', c: 'orange', body: '로컬 챗봇, 엑셀 함수, OCR, 개인정보 점검 도구를 실제 코드와 함께 만듭니다.' },
};
const series = SERIES.map((name, i) => {
  const count = learn.filter((p: any) => p.data.series === name).length;
  return { name, count, ...seriesInfo[name], href: `/learn/#s${i + 1}` };
}).filter((s) => s.count > 0);

const picks = ['57-webllm', '55-whisper', '53-doc-search', '54-ocr'];
const labPicks = picks.map((k) => demos.find((d) => d.url.endsWith(k))).filter(Boolean) as typeof demos;

// 찾아보기 패널의 알약. 관련 글과 목록으로 보낸다.
const topics = [
  { name: 'Ollama', href: '/learn/ollama-first-steps/' }, { name: '양자화', href: '/learn/quantization-explained/' },
  { name: 'GGUF', href: '/glossary/' }, { name: 'RAG', href: '/learn/what-is-rag/' }, { name: '임베딩', href: '/learn/what-is-embedding/' },
  { name: 'Knowledge Stacks', href: '/guide/ks-overview/' }, { name: '컨텍스트 윈도우', href: '/learn/llm-basics-tokens-context/' },
  { name: '폐쇄망', href: '/learn/closed-network-ai-tasks/' }, { name: 'Modelfile', href: '/learn/ollama-modelfile-parameters/' },
  { name: '내 PC 사양', href: '/learn/choose-model-for-your-pc/' }, { name: '모델 순위', href: '/models/' }, { name: 'MCP 도구', href: '/guide/toolbox-tools/' },
  { name: 'Split Chat', href: '/guide/chat-split-chat/' }, { name: '청크', href: '/learn/chunking-documents/' }, { name: '요금제', href: '/guide/pricing/' },
];

const faqs = [
  { q: 'Msty는 무료인가요?', a: 'Studio는 무료 요금제로 시작할 수 있습니다. 로컬·온라인 모델 대화, Agent Mode, Knowledge Stacks 같은 개인용 핵심 기능이 들어 있습니다. 유료 요금제는 Studio Web과 추가 기능을 더합니다.', href: '/guide/pricing/', cta: '요금제 자세히 보기' },
  { q: '인터넷이 없어도 쓸 수 있나요?', a: '로컬 모델과의 대화는 내 PC에서 처리됩니다. 모델을 내려받을 때와 온라인 제공업체의 모델을 쓸 때는 인터넷이 필요합니다.', href: '/learn/what-is-local-ai/', cta: '로컬 AI와 클라우드 AI의 차이' },
  { q: '어떤 PC가 필요한가요?', a: 'Studio는 Windows 10·11(64비트), macOS 11 이상, Linux 64비트를 지원합니다. 돌릴 수 있는 모델의 크기는 메모리와 그래픽카드에 따라 달라집니다.', href: '/learn/choose-model-for-your-pc/', cta: '내 PC에 맞는 모델 고르기' },
  { q: 'Ollama와는 무엇이 다른가요?', a: 'Ollama는 모델을 받아 실행하는 엔진이고 주로 명령줄로 씁니다. Msty Studio는 화면에서 쓰는 작업 공간이며, Ollama를 엔진으로 직접 내려받아 관리합니다.', href: '/guide/connect-ollama/', cta: 'Msty에서 Ollama 모델 쓰기' },
  { q: '회사 문서를 넣어도 되나요?', a: '로컬 모델을 쓰면 문서가 내 PC 안에서 처리됩니다. 온라인 제공업체를 연결한 대화에서는 내용이 그 업체로 전송됩니다. 설치와 사용 범위는 소속 기관의 보안 지침을 먼저 확인하세요.', href: '/learn/before-install-ask-it-security/', cta: '설치 전에 확인할 것' },
  { q: '어디서부터 읽으면 되나요?', a: '처음이라면 학습 경로 글에서 순서를 잡고, Msty 설치 가이드로 넘어갑니다. 설치 없이 먼저 느껴 보려면 브라우저 실습을 열어 보세요.', href: '/learn/learning-path/', cta: '학습 경로 보기' },
];
---
<Base title={SITE.name}>
  <div class="intro" id="intro" aria-hidden="true" hidden>
    <span class="intro-scan"><b id="intro-pct">0%</b></span>
    <h2>내 PC에서 도는 AI,<br />한국어 가이드</h2>
    <dl>
      <dt>Site</dt><dd>MSTY KOREA</dd>
      <dt>Type</dt><dd>LOCAL-FIRST AI GUIDE</dd>
      <dt>Covers</dt><dd>MSTY · OLLAMA · RAG</dd>
      <dt>Status</dt><dd>001 도면을 펼치는 중</dd>
    </dl>
  </div>
  <nav class="dots" aria-label="홈 구역">
    {[['top', '처음'], ['why', '로컬 AI'], ['promise', '핵심'], ['products', '제품'], ['features', '기능'], ['start', '시작'], ['learn', '학습'], ['lab', '실습'], ['faq', '질문']].map(([id, name]) => <a href={`#${id}`} data-dot={id}>{name}</a>)}
  </nav>
  <section class="hero" id="top">
    <div class="wrap">
      <figure class="plate wipe">
        <figcaption class="fig"><b>FIG. 01</b> — 내 PC 안에서 도는 AI</figcaption>
        <span class="pt" style="--x:36.5%;--y:52%;--i:0" data-label="본체 — 모델이 여기서 돕니다" aria-hidden="true"></span>
        <span class="pt left" style="--x:62%;--y:44%;--i:1" data-label="화면 — 질문과 문서, 답" aria-hidden="true"></span>
        <span class="pt left" style="--x:66%;--y:83%;--i:2" data-label="밖으로 나가는 선이 없습니다" aria-hidden="true"></span>
        <img src="/img/hero.webp" width="1600" height="895" alt="본체와 모니터를 콘크리트 건물처럼 그린 펜화. 오른쪽 위에 주황색 원이 떠 있다." fetchpriority="high" decoding="async" />
      </figure>
      <div class="hero-row">
        <h1>보안 걱정 없이<br />내 PC에서 AI 쓰기</h1>
        <div class="hero-side">
          <p class="eyebrow">MSTY · OLLAMA · RAG · 한국어 가이드</p>
          <p class="lead">내 문서를 밖으로 보내지 않고 내 PC에서 AI를 돌립니다. Msty의 제품과 기능, Ollama와 로컬 모델, 문서 검색, 폐쇄망 활용까지 한국어로 자세히 설명합니다.</p>
          <div class="actions">
            <a class="btn-pill" href="/download/">Msty 다운로드 안내</a>
            <a class="btn-ghost" href="/guide/">가이드 읽기</a>
          </div>
          <p class="os-line">지원 환경 <a href="/guide/install-windows/">Windows</a><a href="/guide/install-mac/">macOS</a><a href="/guide/start-linux-web-and-migration/">Linux</a></p>
        </div>
      </div>
      <ul class="stats">
        {stats.map((s) => (
          <li><a href={s.href}><strong class="tabular" data-count={s.n}>{s.n}</strong><span>{s.label}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => ['Msty Studio', 'Ollama', '로컬 모델', 'RAG', '임베딩', 'Knowledge Stacks', '폐쇄망', 'Gemma'].map((w) => <span>{w}</span>))}
    </div>
  </div>

  <section class="section" id="why">
    <div class="wrap">
      <div class="duo">
        <figure class="plate zoom wipe">
          <figcaption class="fig"><b>FIG. 02</b> — 자료는 안에 둔다</figcaption>
          <img src="/img/vault.webp" width="1100" height="1375" alt="문서 더미와 서류함이 안쪽에 놓인 콘크리트 아치와 계단을 그린 펜화. 뒤로 주황색 원이 걸려 있다." loading="lazy" decoding="async" />
        </figure>
        <div class="copy">
          <div class="pad">
            <p class="eyebrow">로컬 우선 AI</p>
            <h2 class="h-judge" data-reveal>모델을 <mark>내 컴퓨터에</mark> 받아서 씁니다</h2>
            <p class="lead" data-reveal>AI 모델을 회사 밖 서버가 아니라 내 PC에서 실행하는 방식입니다. 온라인 서비스보다 답의 수준은 낮을 수 있지만, 자료를 밖으로 보내지 않아도 됩니다.</p>
            <ul class="tags" style="margin-top:20px"><li>사내 문서</li><li>개인정보</li><li>폐쇄망</li><li>반복 업무</li></ul>
            <p class="more"><a class="btn-link" href="/learn/why-run-ai-locally/">로컬에서 돌리는 이유와 한계</a><a class="btn-link" href="/learn/local-or-online-per-task/">작업별로 고르기</a></p>
          </div>
          <ol class="rows">
            {reasons.map((r, i) => (
              <li><span class="rn">0{i + 1}</span><div class="rb"><h3>{r.title}</h3><p>{r.body}</p></div><span class="ri"><Icon name={r.icon} size={20} /></span></li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="statement" id="promise">
    <canvas class="sphere" aria-hidden="true"></canvas>
    <div class="wrap">
      <span class="side-l">보안이 걱정이라면</span><span class="side-r">밖으로 보내지 않으면 됩니다</span>
      <p class="eyebrow">핵심</p>
      <h2 data-reveal>자료는 내 PC 밖으로<br />나가지 않습니다</h2>
      <p class="lead" data-reveal>로컬 모델과의 대화는 내 컴퓨터 안에서 처리됩니다. 온라인 모델을 연결한 대화만 그 업체로 전송됩니다.</p>
    </div>
  </section>

  <section class="section" id="products">
    <div class="wrap">
      <div class="duo flip">
        <figure class="plate zoom wipe">
          <figcaption class="fig"><b>FIG. 03</b> — 네 동이 이어진 한 건물</figcaption>
          <img src="/img/blocks.webp" width="1600" height="1075" alt="높이가 다른 콘크리트 건물 네 동이 다리로 이어진 모습을 그린 펜화. 가장 높은 동 뒤로 주황색 원이 떠 있다." loading="lazy" decoding="async" />
        </figure>
        <div class="copy">
          <div class="pad">
            <p class="eyebrow">Msty 제품</p>
            <h2 class="h-judge" data-reveal>네 가지 제품이 하나로 이어집니다</h2>
            <p class="lead" data-reveal>Msty는 미국에서 만든 로컬 우선 AI 제품군입니다. 필요한 제품 하나로 시작할 수 있고, 모델·에이전트·지식·팀 관리로 넓혀 갈 수 있습니다.</p>
            <div class="diagram" data-reveal aria-hidden="true">
              <span class="node">질문과 문서</span><span class="wire"><i></i></span>
              <span class="node fill">내 PC의 모델</span><span class="wire"><i></i></span>

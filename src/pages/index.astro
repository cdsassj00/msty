<script is:inline>
  // 시작 화면: 방문마다 한 번, 주황 선이 훑고 지나간 뒤 사라진다. 모션 줄이기 설정이면 건너뛴다.
  (() => {
    const el = document.getElementById('intro');
    let seen = false;
    try { seen = sessionStorage.getItem('intro') === '1'; sessionStorage.setItem('intro', '1'); } catch {}
    if (!el || seen || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    el.hidden = false;
    const pct = document.getElementById('intro-pct'), t0 = performance.now(), dur = 1250;
    const tick = (t) => {
      const k = Math.min(1, (t - t0) / dur);
      pct.textContent = Math.round(k * 100) + '%';
      if (k < 1) requestAnimationFrame(tick); else el.classList.add('done');
    };
    requestAnimationFrame(tick);
    setTimeout(() => el.classList.add('done'), 2200); // 그리기가 멈춘 탭에서도 반드시 걷힌다
  })();
  // 구역 점 메뉴: 지금 보이는 구역을 표시하고, 검은 구역 위에서는 점 색을 바꾼다.
  (() => {
    const nav = document.querySelector('.dots');
    if (!nav) return;
    const items = [...nav.querySelectorAll('a')].map((a) => ({ a, el: document.getElementById(a.dataset.dot) })).filter((x) => x.el);
    let queued = false;
    const update = () => {
      queued = false;
      const mid = innerHeight / 2;
      let current = items[0];
      for (const it of items) if (it.el.getBoundingClientRect().top <= mid) current = it;
      for (const it of items) it.a.classList.toggle('on', it === current);
      nav.classList.toggle('invert', current.el.classList.contains('dark') || current.el.classList.contains('statement'));
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  })();
  // 약속 구역의 점으로 이루어진 구. 화면에 보일 때만 그리고, 모션 줄이기 설정이면 한 번만 그린다.
  (() => {
    const cv = document.querySelector('.sphere');
    if (!cv) return;
    const ctx = cv.getContext('2d');
    const N = 900, pts = [];
    for (let i = 0; i < N; i++) { const y = 1 - (i / (N - 1)) * 2, r = Math.sqrt(1 - y * y), t = i * 2.399963; pts.push([Math.cos(t) * r, y, Math.sin(t) * r]); }
    let w = 0, h = 0, angle = 0, visible = false, raf = 0;
    const ink = getComputedStyle(cv).color; // 점의 색은 CSS에서 정한다
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const size = () => { const b = cv.getBoundingClientRect(), d = Math.min(devicePixelRatio || 1, 2); w = b.width; h = b.height; cv.width = w * d; cv.height = h * d; ctx.setTransform(d, 0, 0, d, 0, 0); };
    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      const R = Math.min(w, h) * 0.42, cx = w / 2, cy = h / 2, ca = Math.cos(angle), sa = Math.sin(angle), cb = Math.cos(0.35), sb = Math.sin(0.35);
      for (const [x, y, z] of pts) {
        const x1 = x * ca + z * sa, z1 = z * ca - x * sa, y1 = y * cb - z1 * sb, z2 = z1 * cb + y * sb;
        const k = (z2 + 1.6) / 2.6;
        ctx.globalAlpha = 0.18 + k * 0.82;
        ctx.fillStyle = ink;
        ctx.beginPath(); ctx.arc(cx + x1 * R, cy + y1 * R, 0.6 + k * 1.5, 0, 6.2832); ctx.fill();
      }
    };
    const loop = () => { angle += 0.0032; draw(); if (visible && !still) raf = requestAnimationFrame(loop); };
    const check = () => {
      const b = cv.getBoundingClientRect(), now = b.bottom > 0 && b.top < innerHeight;
      if (now && !visible) { visible = true; cancelAnimationFrame(raf); loop(); }
      if (!now) visible = false;
    };
    size(); draw(); check();
    addEventListener('resize', () => { size(); draw(); }, { passive: true });
    addEventListener('scroll', check, { passive: true });
  })();
  // 숫자 카운트업. 모션 줄이기 설정이면 실행하지 않는다.
  (() => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    for (const el of document.querySelectorAll('[data-count]')) {
      const end = Number(el.dataset.count), t0 = performance.now(), dur = 900;
      const tick = (t) => {
        const k = Math.min(1, (t - t0) / dur);
        el.textContent = String(Math.round(end * (1 - Math.pow(1 - k, 3))));
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  })();
</script>

---
import Base from '../layouts/Base.astro';
import terms from '../data/glossary.json';
const COLORS = ['blue','purple','green','orange','teal','pink'];
const groups = [...new Set(terms.map((t) => t.group))];
---
<Base title="용어 풀이" description="로컬 AI를 쓸 때 자주 만나는 용어를 쉬운 말로 풉니다.">
  <header class="page-head">
    <div class="wrap narrow">
      <h1 class="h-judge">용어 풀이</h1>
      <p class="lead">로컬 AI를 쓸 때 자주 만나는 용어를 쉬운 말로 풉니다.</p>
    </div>
  </header>
  <section class="page-body">
    <div class="wrap narrow">
      <div class="chip-row jump scroll-thin">
        {groups.map((g, i) => <a class={`badge c-${COLORS[i % 6]}`} href={`#t${i + 1}`}>{g}</a>)}
      </div>
      {groups.map((g, i) => (
        <>
          <h2 class={`h-judge series-title c-${COLORS[i % 6]}`} id={`t${i + 1}`}><span class="num tabular">{i + 1}</span>{g}<span class="count">{terms.filter((t) => t.group === g).length}개</span></h2>
          <dl class="glossary prose">
            {terms.filter((t) => t.group === g).map((t) => (
              <>
                <dt id={t.id}>{t.term}</dt>
                <dd>
                  {t.desc}
                  {t.say && <p class="say">AI에게 이렇게 말하기: {t.say}</p>}
                </dd>
              </>
            ))}
          </dl>
        </>
      ))}
    </div>
  </section>
</Base>

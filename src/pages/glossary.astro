---
import Base from '../layouts/Base.astro';
import terms from '../data/glossary.json';
const groups = [...new Set(terms.map((t) => t.group))];
---
<Base title="용어 풀이" description="로컬 AI를 쓸 때 자주 만나는 용어를 쉬운 말로 풉니다.">
  <section class="section">
    <div class="wrap narrow">
      <h1 class="h-judge">용어 풀이</h1>
      <p class="lead">로컬 AI를 쓸 때 자주 만나는 용어를 쉬운 말로 풉니다.</p>
      <div class="chip-row" style="margin-top:24px">
        {groups.map((g, i) => <a class="chip chip-plain" href={`#t${i + 1}`}>{g}</a>)}
      </div>
      {groups.map((g, i) => (
        <>
          <h2 class="h-judge series-title" id={`t${i + 1}`}>{g}</h2>
          <dl class="glossary prose">
            {terms.filter((t) => t.group === g).map((t) => (
              <>
                <dt id={t.id}>{t.term}</dt>
                <dd>
                  {t.desc}
                  {t.say && <p class="say">AI에게 이렇게 말하기: {t.say}</p>}
                </dd>
              </>
            ))}
          </dl>
        </>
      ))}
    </div>
  </section>
</Base>

---
import { LABELS, postUrl, groupOf, colorOf, type CollectionName } from '../lib/posts';
interface Props { entry: any; n?: number }
const { entry, n } = Astro.props;
const group = groupOf(entry) ?? LABELS[entry.collection as CollectionName].title;
---
<a class={`panel card post-card c-${colorOf(entry)}`} href={postUrl(entry.collection, entry.id)}>
  {n && <span class="ord tabular">{String(n).padStart(2, '0')}</span>}
  <p class="badge">{group}</p>
  <h3>{entry.data.title}</h3>
  <p>{entry.data.description}</p>
</a>
